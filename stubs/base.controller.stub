<?php

namespace App\Http\Controllers\{{ucfirst($modelName)}};

use App\Engine\{{ucfirst($modelName)}}\Services\Contracts\{{ucfirst($modelName)}}ServiceInterface;
use App\Helpers\Builder\FormMaking;
use App\Http\Controllers\Controller;
use App\Models\{{ucfirst($modelName)}};
use Exception;
use Illuminate\Contracts\View\Factory;
use Illuminate\Contracts\View\View;
use Illuminate\Foundation\Application;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Validation\Rule;
use Illuminate\Validation\ValidationException;
use Symfony\Component\HttpFoundation\Response as ResponseAlias;
use Yajra\DataTables\Facades\DataTables;

class {{ucfirst($modelName)}}Controller extends Controller
{
    private {{ucfirst($modelName)}}ServiceInterface $service;

    public function __construct({{ucfirst($modelName)}}ServiceInterface $service)
    {
        $this->service = $service;
    }

    public function index(): View|Application|Factory|\Illuminate\Contracts\Foundation\Application
    {
        return view('backend.{{strtolower($modelName)}}.index')->with([
            'title' => '{{ucfirst($modelName)}}s',
            'buttons' => [
                [
                    'label' => 'Add New Item',
                    'url' => route('{{strtolower($modelName)}}.add'),
                    'icon' => 'ri-add-line',
                    'classes' => 'btn-sm btn-outline-primary',
                ],
            ],
            'table' => '{{strtolower($modelName)}}_table',
            'columns' => [
                "Name",
                "Status",
                "Action"
            ],
        ]);
    }

    public function add(): Factory|Application|View|\Illuminate\Contracts\Foundation\Application
    {
        $formConfig = (new FormMaking())
            ->action(route('{{strtolower($modelName)}}.store'))
            ->method('POST')
            ->startRow()
            ->addFormFields([
                [
                    'type' => 'text',
                    'name' => 'name',
                    'label' => 'Name',
                    'col' => 'col-md-12 mb-3',
                    'value' => '',
                    'required' => true,
                    'validation_feedback' => 'Looks good!',
                ]
            ])
            ->endRow()
            ->startRow()
            ->addFormFields([
                [
                    'type' => 'radio',
                    'name' => 'status',
                    'label' => 'Select status',
                    'options' => [
                        ['value' => 'active', 'label' => 'Active', 'checked' => 'active'],
                        ['value' => 'inactive', 'label' => 'Inactive', 'checked' => ''],
                    ],
                    'col' => 'col-6 mb-3',
                    'required' => true,
                    'invalid_feedback' => 'More example invalid feedback text',
                ],
            ])
            ->endRow()
            ->startRow()
            ->addInput([
                'type' => 'submit',
                'value' => 'Submit form',
                'col' => 'col-12 mb-3',
                'class' => 'btn btn-sm btn-primary',
            ])
            ->endRow()
            ->build();

        return view('backend.{{strtolower($modelName)}}.add')->with([
            'title' => '{{ucfirst($modelName)}} Add',
            'buttons' => [
                [
                    'label' => 'Add New',
                    'url' => route('{{strtolower($modelName)}}.index'),
                    'icon' => 'ri-add-line',
                    'classes' => 'btn-sm btn-outline-primary',
                ],
            ],
            'formConfig' => $formConfig
        ]);
    }

    /**
     * @throws ValidationException
     */
    public function store(Request $request): RedirectResponse
    {
        $this->validate($request, [
            'name' => 'required|unique:{{strtolower($modelName)}}s,name',
            'status' => 'required',
        ]);

        $response = $this->service->create($request->all());

        if ($response) {
            return redirect()->route('{{strtolower($modelName)}}.index')->with('success', '{{ucfirst($modelName)}} added successfully.');
        }

        return redirect()->back()->with('error', 'Something went wrong. Please try again.');
    }

    public function edit(Request $request, $id): View|Application|Factory|\Illuminate\Contracts\Foundation\Application
    {
        $data = $this->service->find($id);

        $formConfig = (new FormMaking())
            ->action(route('{{strtolower($modelName)}}.update', ['id' => $id]))
            ->method('POST')
            ->startRow()
            ->addFormFields([
                [
                    'type' => 'text',
                    'name' => 'name',
                    'label' => 'Name',
                    'col' => 'col-md-6 mb-3',
                    'value' => $data->name,
                    'required' => true,
                    'validation_feedback' => 'Looks good!',
                ]
            ])
            ->endRow()
            ->startRow()
            ->addFormFields([
                [
                    'type' => 'radio',
                    'name' => 'status',
                    'label' => 'Select status',
                    'options' => [
                        ['value' => 'active', 'label' => 'Active', 'checked' => $data->status === 'active'],
                        ['value' => 'inactive', 'label' => 'Inactive', 'checked' => $data->status === 'inactive'],
                    ],
                    'col' => 'col-6 mb-3',
                    'required' => true,
                ],
            ])
            ->endRow()
            ->startRow()
            ->addInput([
                'type' => 'submit',
                'value' => 'Submit form',
                'col' => 'col-6 mb-3',
                'class' => 'btn btn-primary',
            ])
            ->endRow()
            ->build();

        return view('backend.{{strtolower($modelName)}}.edit')->with([
            'title' => '{{ucfirst($modelName)}} Edit',
            'buttons' => [
                [
                    'label' => 'Add New',
                    'url' => route('{{strtolower($modelName)}}.index'),
                    'icon' => 'ri-add-line',
                    'classes' => 'btn-sm btn-outline-primary',
                ],
                [
                    'label' => 'Back to List',
                    'url' => route('{{strtolower($modelName)}}.index'),
                    'icon' => 'ri-add-line',
                    'classes' => 'btn-sm btn-outline-danger',
                ],
            ],
            'formConfig' => $formConfig,
        ]);
    }

    /**
     * @throws ValidationException
     */
    public function update(Request $request, $id): RedirectResponse
    {
        $this->validate($request, [
            'name' => [
                'required',
                Rule::unique((new {{ucfirst($modelName)}})->getTable())->ignore($id),
            ],
            'status' => 'required|in:active,inactive',
        ]);

        $response = $this->service->update($id, $request->all());

        if ($response) {
            return redirect()->route('{{strtolower($modelName)}}.index')->with('success', '{{ucfirst($modelName)}} updated successfully.');
        }

        return redirect()->back()->with('error', 'Something went wrong. Please try again.');
    }

    public function delete(Request $request): JsonResponse
    {
        $data = $this->service->delete($request->input('id'));

        if ($data) {
            return response()->json([
                'message' => '{{ucfirst($modelName)}} deleted successfully',
                'status_code' => ResponseAlias::HTTP_OK,
                'data' => []
            ], ResponseAlias::HTTP_OK);
        }

        return response()->json([
            'message' => '{{ucfirst($modelName)}} delete failed',
            'status_code' => ResponseAlias::HTTP_BAD_REQUEST,
            'data' => []
        ], ResponseAlias::HTTP_BAD_REQUEST);
    }

    /**
     * @param Request $request
     * @return JsonResponse
     * @throws Exception
     */
    public function dataTableList(Request $request): JsonResponse
    {
        $data = $this->service->dataTableData()->orderBy('id', 'desc');

        return DataTables::of($data)
            ->filter(function ($query) {
                if (request()->has('name') && !is_null(request('name'))) {
                    $query->where('name', 'like', '%' . request('name') . '%');
                }
            }, true)
            ->addColumn('name', function ($data) {
                return $data->name;
            })
            ->editColumn('status', function ($data) {
                return $data->status;
            })
            ->addColumn('action', function ($data) {
                $editRoute = route('{{strtolower($modelName)}}.edit', $data->id);
                $viewRoute = route('{{strtolower($modelName)}}.edit', $data->id); // Optional, replace with actual route if needed
                $deleteRoute = null; // Replace with delete route if needed
                return actionDropdown($data->id, $editRoute, $viewRoute, $deleteRoute);
            })
            ->rawColumns(['action'])
            ->toJson();
    }
}
